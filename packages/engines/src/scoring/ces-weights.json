  "hardCaps": {
    "description": "Applied AFTER weighted sum. Clamp CES to the specified ceiling when rule matches.",
    "rules": [
      { "id": "cap:low_ocr_confidence", "if": "ocrConfidence < 0.5", "ceiling": 60 },
      { "id": "cap:policy_risk_high", "if": "platformPolicyRiskScore >= 70", "ceiling": 50 },
      { "id": "cap:policy_risk_moderate", "if": "platformPolicyRiskScore >= 50", "ceiling": 65 },
      { "id": "cap:visual_democracy", "if": "visualDemocracyFlag === true", "ceiling": 62 },
      { "id": "cap:unreadable_at_thumb", "if": "readabilityAtThumbnail < 40", "ceiling": 58 },
      { "id": "cap:no_cta_on_sales", "if": "ctaPresent === false && objective === 'PPC_SALES'", "ceiling": 45 },
      { "id": "cap:no_cta_on_conversion", "if": "ctaPresent === false && objective === 'PPC_CONVERSION'", "ceiling": 50 },
      { "id": "cap:multiple_ctas_ppc", "if": "singularCTAFlag === false && objective.startsWith('PPC')", "ceiling": 65 },
      { "id": "cap:no_offer_on_conversion", "if": "offerPresent === false && objective === 'PPC_CONVERSION'", "ceiling": 60 },
      { "id": "cap:missing_mandatory_disclosure", "if": "mandatoryDisclaimerPresent === false && ['real_estate','healthcare','insurance'].includes(vertical)", "ceiling": 55 }
    ]
  },
  "boostRules": {
    "description": "Applied AFTER weighted sum, BEFORE hard caps.",
    "rules": [
      { "id": "boost:exceptional_hook", "if": "hookStrength >= 85", "delta": 3 },
      { "id": "boost:exceptional_offer", "if": "priceAnchorPresent === true && savingsMagnitudeSalience >= 70", "delta": 3 },
      { "id": "boost:exceptional_camouflage", "if": "feedCamouflageScore >= 80 && objective.startsWith('SOCIAL')", "delta": 3 },
      { "id": "boost:exceptional_brand", "if": "brandRecognizabilityWithoutLogo >= 80", "delta": 2 }
    ]
  },
