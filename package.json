{
  "name": "sakhaa-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Sakhaa Forge V0 walking skeleton.",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @sakhaa-forge/contracts build && pnpm db:generate && pnpm --filter web build",
    "build:cpu": "pnpm --filter signal-cpu-worker build",
    "start:cpu": "pnpm --filter signal-cpu-worker start",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter web dev",
    "dev:gpu": "node scripts/dev-gpu.mjs",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "generate": "node scripts/generate-contracts.mjs",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:rls": "node --test tests/rls/*.test.mjs",
    "db:generate": "node packages/db/scripts/db-generate.mjs",
    "db:migrate:dev": "node packages/db/scripts/db-migrate-dev.mjs",
    "db:validate": "node packages/db/scripts/db-validate.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "chromedriver": "^151.0.1",
    "selenium-webdriver": "^4.46.0"
  }
}
