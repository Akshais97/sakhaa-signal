// Root Prisma schema pointer for default CLI discovery
// Canonical schema lives in packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../packages/db/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
